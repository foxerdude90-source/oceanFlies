<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#F8FAFC"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ocean.studio IDE"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Main Workspace Split Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Code Editor & Preview Tab area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <EditText
                android:id="@+id/codeEditorInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="top|start"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:visibility="gone" />

            <WebView
                android:id="@+id/previewWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible" />
        </FrameLayout>

        <!-- Native PTY Terminal View Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <com.ocean.terminal.TerminalView
                android:id="@+id/terminalView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Soft Keyboard Bar -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="#F8FAFC">
                <LinearLayout
                    android:id="@+id/keyboardBar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- Ocean Agent Chat Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:orientation="vertical"
        android:background="#F8FAFC"
        android:padding="8dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:id="@+id/chatContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/chatInput"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="Ask Ocean Agent..."
                android:padding="8dp"
                android:textSize="14sp"
                android:background="#FFFFFF" />

            <Button
                android:id="@+id/sendChatBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Send"
                android:textColor="#FFFFFF"
                android:background="#1E293B" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

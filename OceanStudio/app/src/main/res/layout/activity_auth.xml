<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F17"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Logo & Branding Header -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌊 Ocean.studio"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#F8FAFC"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI-POWERED MOBILE IDE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#06B6D4"
                android:letterSpacing="0.15"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Glassmorphic Auth Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign In to your Workspace"
                android:textColor="#F8FAFC"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Access your AI agent, native POSIX terminal, and cloud project sync."
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp" />

            <!-- Email Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMAIL ADDRESS"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <EditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:hint="developer@oceanstudio.ai"
                android:textColorHint="#475569"
                android:textColor="#F8FAFC"
                android:inputType="textEmailAddress"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />

            <!-- Password Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PASSWORD"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:hint="••••••••••••"
                android:textColorHint="#475569"
                android:textColor="#F8FAFC"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp" />

            <!-- Primary Action Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/signInBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_cyan_button"
                android:text="Sign In / Register"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textAllCaps="false" />

            <!-- Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp">
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#2A364F" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  OR CONNECT WITH  "
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#2A364F" />
            </LinearLayout>

            <!-- Google Auth Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/googleBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:text="Google Account"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:layout_marginBottom="10dp" />

            <!-- GitHub OAuth Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/githubBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:text="GitHub Account"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:layout_marginBottom="16dp" />

            <!-- Preview Mode Bypass -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/previewBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:text="⚡ Preview Login (Bypass Auth)"
                android:textColor="#06B6D4"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
